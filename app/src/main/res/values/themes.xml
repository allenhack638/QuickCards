<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QuickCards" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_brand</item>
        <item name="colorOnPrimary">@color/primary_on</item>

        <item name="colorSecondary">@color/secondary_brand</item>
        <item name="colorOnSecondary">@color/primary_on</item>

        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/window_light_navigation_bar</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>

        <item name="android:windowBackground">@color/background_app</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/qc_splash_mark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/background_app</item>
    </style>
</resources>
